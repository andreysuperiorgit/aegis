{
  "name": "aegis",
  "version": "0.1.0",
  "description": "Multi-chain scam filter + smart sniper for Solana (Pump.fun), Robinhood Chain (Pons V2) & Base (Clanker)",
  "type": "module",
  "scripts": {
    "server": "node src/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": { "node": ">=18.0.0" },
  "license": "MIT",
  "keywords": ["solana","robinhood-chain","base","pump-fun","pons","memecoin","scanner","sniper","scam-filter","grok"]
}
