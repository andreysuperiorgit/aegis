{
  "name": "aegis",
  "version": "0.2.0",
  "description": "Multi-chain scam filter + smart sniper with Second Brain memory · Solana, Robinhood Chain & Base",
  "type": "module",
  "scripts": {
    "server": "node src/aegis/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "scan": "node scripts/scan.js",
    "monitor": "node scripts/monitor.js",
    "memory:stats": "node scripts/memory-stats.js",
    "memory:flag": "node scripts/memory-flag.js",
    "test": "node --test tests/",
    "lint": "eslint src/ scripts/",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\"",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  },
  "engines": { "node": ">=18.0.0" },
  "license": "MIT",
  "keywords": [
    "solana",
    "robinhood-chain",
    "base",
    "pump-fun",
    "pons",
    "memecoin",
    "scanner",
    "sniper",
    "scam-filter",
    "grok",
    "aegis",
    "second-brain",
    "memory"
  ]
}
